# NXD environment variables — copy to .env (gitignored) or export in your shell.
# NXD is offline-first: with a local Ollama, NO variables are required.
# Every key below is optional and only unlocks cloud/diagnostic behaviour.
#
# All keys verified against the code at commit 7ddd15d — file references inline.

# ---------------------------------------------------------------------------
# Logging (cmd/nxd/main.go, internal/nlog/nlog.go)
# ---------------------------------------------------------------------------
# Log level: debug | info | warn | error (default: info; overrides
# workspace.log_level from nxd.yaml when set)
#NXD_LOG_LEVEL=info

# Log format: text (human, default) | json (machine / log aggregators)
#NXD_LOG_FORMAT=text

# ---------------------------------------------------------------------------
# Update checker (internal/cli/root.go)
# ---------------------------------------------------------------------------
# Set to "false" to disable the periodic model/binary update check.
# Also configurable via workspace.update_check in nxd.yaml.
#NXD_UPDATE_CHECK=false

# ---------------------------------------------------------------------------
# Ollama (internal/cli/req.go — buildLLMClientDefault)
# ---------------------------------------------------------------------------
# Override the Ollama base URL. Defaults to the client library default
# (local Ollama) when unset. Also propagated into agent tmux sessions
# (internal/tmux/env.go) and CLI runtime sessions (internal/runtime/registry.go).
#OLLAMA_HOST=http://localhost:11434

# ---------------------------------------------------------------------------
# Cloud provider API keys — ONLY needed for cloud mode
# (models.<role>.provider set to anthropic / openai / google / google+ollama)
# ---------------------------------------------------------------------------
# Required when any role uses provider "anthropic" (internal/cli/req.go).
# NOTE: intentionally NOT exported into Claude Code agent sessions — agents
# authenticate via your OAuth session instead (internal/runtime/registry.go).
#ANTHROPIC_API_KEY=

# Required when any role uses provider "openai" (internal/cli/req.go).
# Passed through to agent runtime sessions.
#OPENAI_API_KEY=

# Required for provider "google"; optional for "google+ollama" (the default),
# which degrades gracefully to Ollama-only when unset (internal/cli/req.go).
# Also checked by `nxd doctor` (internal/cli/doctor.go) and the model
# update checker (internal/cli/root.go, internal/cli/models.go).
#GOOGLE_AI_API_KEY=

# Passed through to agent runtime tmux sessions for tools that expect the
# generic Google/Gemini key names (internal/runtime/registry.go). Not read
# by NXD's own LLM clients.
#GOOGLE_API_KEY=
#GEMINI_API_KEY=
