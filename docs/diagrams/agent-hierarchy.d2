direction: down

title: |md
  # Agent Roles, Complexity Routing & Escalation
| {near: top-center; style.font-size: 22; style.bold: true}

defaults: Default config {
  shape: page
  style.fill: "#f5f5f5"
  desc: |md
    Every role: gemma4:e4b on Ollama
    Override per role in nxd.yaml
  |
}

req: Requirement {
  shape: oval
  style.fill: "#e8f0fe"
}

inv: Investigator\n(models.investigator) {
  style.fill: "#f5f5f5"
  desc: |md
    Existing repos only
  |
}

tl: Tech Lead\n(models.tech_lead) {
  style.fill: "#fef7e0"
  style.stroke-width: 2
  desc: |md
    Decompose
    Score complexity
    Build DAG
  |
}

router: Complexity router\n(thresholds or Bayesian) {
  shape: diamond
  style.fill: "#f5f5f5"
}

junior: Junior\n(models.junior) {
  style.fill: "#e6f4ea"
  desc: |md
    Complexity 1-3
  |
}

intermediate: Intermediate\n(models.intermediate) {
  style.fill: "#e8eaf6"
  desc: |md
    Complexity 4-5
  |
}

senior: Senior\n(models.senior) {
  style.fill: "#fef7e0"
  desc: |md
    Complexity 6+
    Escalated stories
  |
}

runtime: Coding runtime {
  style.fill: "#e8eaf6"
  desc: |md
    Native Gemma when the model matches (default)
    otherwise a tmux CLI agent
  |
}

reviewer: Code Review\n(models.senior) {
  style.fill: "#fef7e0"
}

qa: QA\n(no model) {
  style.fill: "#fce8e6"
  desc: |md
    qa.success_criteria commands
  |
}

merge: Security gate, then merge {
  shape: oval
  style.fill: "#e6f4ea"
}

ladder: Escalation ladder {
  style.fill: "#fde7e9"
  desc: |md
    Tier 0 same role, tier 1 Senior,
    tier 2 Manager, tier 3 Tech Lead re-plan,
    tier 4 pause. nxd resume does not attach
    Manager or Planner: tiers 2-3 go to Senior.
  |
}

notwired: Defined but not wired {
  style.fill: "#f5f5f5"
  style.stroke-dash: 3
  desc: |md
    Supervisor (drift detection)
    Reputation scoring
  |
}

req -> inv: existing repo
req -> tl
inv -> tl: report
tl -> router: stories with complexity
router -> junior: 1-3
router -> intermediate: 4-5
router -> senior: 6+
junior -> runtime
intermediate -> runtime
senior -> runtime
runtime -> reviewer: diff
reviewer -> qa: approve
qa -> merge: pass
reviewer -> ladder: reject {style.stroke-dash: 3; style.stroke: "#d93025"}
qa -> ladder: fail {style.stroke-dash: 3; style.stroke: "#d93025"}
ladder -> router: re-dispatch {style.stroke-dash: 3; style.stroke: "#f9ab00"}
