direction: right

title: |md
  # Pipeline Flow: Requirement → Merged Code
| {near: top-center; style.font-size: 22; style.bold: true}

req: nxd req {
  shape: oval
  style.fill: "#e8f0fe"
}

plan: Plan {
  style.fill: "#fef7e0"
  desc: |md
    **Tech Lead LLM** (models.tech_lead)
    - Decomposes into stories
    - Assigns complexity (Fibonacci)
    - Builds DAG of deps
  |
}

dag: DAG of Stories {
  shape: page
  style.fill: "#f5f5f5"
}

wave: Wave Dispatcher {
  style.fill: "#fef7e0"
  desc: |md
    nxd resume
    Topological sort
    Parallel per wave
    Bayesian role routing
  |
}

agents: Coding Agents {
  shape: rectangle
  style.fill: "#e8eaf6"
  junior: Junior
  intermediate: Intermediate
  senior: Senior\n(escalations)
  note: Native Gemma runtime\nby default
}

criteria: Criteria Gate {
  shape: hexagon
  style.fill: "#fde7e9"
  desc: |md
    qa.success_criteria
    must pass before
    task_complete is accepted
  |
}

review: Code Review {
  style.fill: "#fef7e0"
  desc: |md
    **Senior model** (models.senior)
    Advisory when
    criteria_authoritative
  |
}

qa: QA {
  style.fill: "#fef7e0"
  desc: |md
    qa.success_criteria
    commands (no LLM)
  |
}

security: Security Gate {
  shape: hexagon
  style.fill: "#fde7e9"
  desc: |md
    Scanners + LLM review
    Critical finding pauses
  |
}

merge: Merge + Cleanup {
  style.fill: "#e6f4ea"
  desc: |md
    `git merge --no-ff`
    or GitHub PR
    Worktree + branches removed
    Post-merge integration build
  |
}

completion: Completion Gate {
  shape: oval
  style.fill: "#e6f4ea"
  desc: |md
    Build + tests on mainline
    REQ_COMPLETED or REQ_BLOCKED
  |
}

paused: Requirement paused {
  shape: oval
  style.fill: "#fce8e6"
}

req -> plan
plan -> dag
dag -> wave
wave -> agents
agents -> criteria: task_complete claim
criteria -> agents: fail → self-correct {style.stroke: "#d93025"; style.stroke-dash: 3}
criteria -> review: pass
review -> qa: approve
review -> wave: reject → draft {style.stroke: "#f9ab00"; style.stroke-dash: 3}
qa -> security: pass
qa -> wave: fail → draft {style.stroke: "#d93025"; style.stroke-dash: 3}
security -> merge: pass
security -> paused: finding {style.stroke: "#d93025"; style.stroke-dash: 3}
merge -> completion: last story
